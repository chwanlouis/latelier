# Chatbot environment variables
# Copy to .env and fill in real values

# App
DEBUG=false
HOST=0.0.0.0
PORT=8000

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# MCP Server
MCP_BASE_URL=https://localhost:8443
MCP_USERNAME=admin
MCP_PASSWORD=admin123
# Set to the path of the CA bundle or server cert for TLS verification.
# Set to "false" only during local development with self-signed certificates.
MCP_SSL_VERIFY=true

# CORS
CORS_ORIGINS=http://localhost:3000

# Neo4j (direct)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
